# Render/test outputs — never commit these, from any directory.
Fdump.bin
floatimage.bin
intimage.img
image.pgm

# oh-my-claudecode session state.
.omc/

# Editor / IDE config, at any directory level.
.vscode/

# Parity harness (cuda/test): gitignored build output, run output, reference
# binary, and machine-local render inputs. Only cuda/test/ source is committed.
cuda/test/build/
cuda/test/inputs/
cuda/test/reference/
cuda/test/workdir/
cuda/testrun/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editable-install metadata fragment (regenerated by pip)
/src/nanobrag_torch.egg-info/PKG-INFO

# Built C reference binary at repository root (see INSTALL.md)
/nanoBragg

# Parity / pytest run outputs (use git add -f if a path must be committed)
/reports/

# Cursor / local IDE (use git add -f to track specific files)
/.cursor/

# Ad hoc simulator outputs at repository root
/*.img
/*.pgm

# Standard build artifacts
/build/
/dist/
*.egg
